rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
             && (request.auth.token.email.toLowerCase() == 'admin@bhf.com'
                 || request.auth.token.email.toLowerCase() == 'superadmin@bhf.com');
    }

    function isSuperAdmin() {
      return request.auth != null
             && request.auth.token.email.toLowerCase() == 'superadmin@bhf.com';
    }

    // Instructor accounts are stored in /instructors/{uid} with an
    // "active" flag (see script.js addInstructorAccount /
    // removeInstructorAccount). Checking that here — instead of only
    // trusting admin@bhf.com — is what lets instructors actually publish
    // courses and program categories from the Instructor Portal.
    function isActiveInstructor() {
      return request.auth != null
             && exists(/databases/$(database)/documents/instructors/$(request.auth.uid))
             && get(/databases/$(database)/documents/instructors/$(request.auth.uid)).data.active == true;
    }

    match /courses/{courseId} {
      allow read: if true;
      // Admins can write any course. Instructors can only create/update
      // their own courses (instructorId must match their uid) and cannot
      // take over or edit someone else's.
      allow create: if isAdmin()
                    || (isActiveInstructor() && request.resource.data.instructorId == request.auth.uid);
      allow update, delete: if isAdmin()
                    || (isActiveInstructor() && resource.data.instructorId == request.auth.uid);
    }

    match /categories/{categoryId} {
      allow read: if true;
      // Instructors are allowed to add new program categories from the
      // Instructor Portal, matching the UI (add-course.html shows an
      // "Add Category" button to instructors). Only admins can edit or
      // remove a category, matching the UI hiding the remove button for
      // non-admins.
      allow create: if isAdmin() || isActiveInstructor();
      allow update, delete: if isAdmin();
    }

    // This collection previously had NO rule at all, which meant every
    // read fell through to the catch-all "deny everything" rule below.
    // script.js reads this doc for the signed-in user's own uid right
    // after login (onAuthStateChanged -> getInstructorProfile) to decide
    // whether their role is "instructor" — with reads blocked, that call
    // always failed, so every instructor silently resolved to role
    // "user" once the app re-checked auth state fresh (e.g. right after
    // publishing a course), bouncing them to dashboard.html instead of
    // the Instructor Portal.
    match /instructors/{instructorId} {
      // A signed-in user may look up their own instructor doc (needed so
      // their own role resolves correctly on login/refresh), or an admin
      // may look up any instructor doc.
      allow get: if request.auth != null
                 && (request.auth.uid == instructorId || isAdmin());
      // Listing the whole collection (Manage Instructors page) stays
      // admin-only.
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Every account gets a lightweight profile doc here on login, keyed by
    // lowercased email (see syncUserProfile in script.js). This collection
    // previously had NO rule at all, so it fell through to the catch-all
    // "deny everything" rule below — every login's profile sync silently
    // failed with permission-denied, and "Total Users" on the admin
    // dashboard (which reads this whole collection) had nothing to count.
    match /users/{userEmail} {
      // A signed-in user may read/create/update their OWN profile doc only
      // (doc ID == their lowercased email). Admin can read/write any of them.
      allow get: if request.auth != null
                 && (request.auth.token.email.toLowerCase() == userEmail || isAdmin());
      // Listing the whole collection (admin dashboard "Total Users" stat,
      // Manage Users page) stays admin-only.
      allow list: if isAdmin();
      allow create, update: if request.auth != null
                 && (request.auth.token.email.toLowerCase() == userEmail || isAdmin());
      allow delete: if isAdmin();
    }

    match /overrides/{overrideId} {
      allow read: if true;
      // Admins can edit any page's content override. Instructors are also
      // allowed to use inline Edit Mode, but only on the "programs" page
      // (see script.js initAdminInlineEdit's canUseEditMode check) — so
      // their writes here are scoped to that page too. Without this,
      // instructor edits saved through Edit Mode were silently rejected by
      // these rules (permission-denied), so they only ever landed in that
      // browser's localStorage and disappeared on refresh/other devices.
      allow create, update: if isAdmin()
                    || (isActiveInstructor() && request.resource.data.page == "programs");
      allow delete: if isAdmin()
                    || (isActiveInstructor() && resource.data.page == "programs");
    }

    // Certificates: anyone can read (needed for public verification).
    // A certificate can be created either by the learner it belongs to
    // (self-issued on course completion) OR by an admin manually issuing
    // one from the Certificates admin page. The original rule only
    // allowed the former, which silently failed every admin-issued
    // certificate — it would never get saved, so verifying its code
    // later found nothing.
    match /certificates/{certId} {
      allow read: if true;
      allow create: if request.auth != null
                    && (request.auth.token.email == request.resource.data.email
                        || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                    || (request.auth != null
                        && request.auth.token.email.toLowerCase() == request.resource.data.email.toLowerCase());
      allow update, delete: if isAdmin();
    }

    match /examSchedule/{examId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /calendarEvents/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    match /quizzes/{quizId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /quizResponses/{responseId} {
      allow read: if request.auth != null && (isSuperAdmin() || request.auth.uid == resource.data.userId);
      allow create, update: if request.auth != null;
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}